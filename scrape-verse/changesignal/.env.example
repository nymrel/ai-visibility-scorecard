# Required only for a live Bright Data run.
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=
TARGET_URL=https://example.com/changelog
TARGET_NAME=Example changelog

# Optional output paths.
BASELINE_PATH=fixtures/baseline.json
ARTIFACT_DIR=artifacts

# Required only for `npm run heal`.
HEAL_PROMPT=Repair the collector so it returns title, url, published_at, summary, and source_name.
